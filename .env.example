# Server settings. Never commit the populated .env file.
PORT=4188
VELQON_HOST=127.0.0.1
VELQON_PUBLIC_ORIGIN=http://127.0.0.1:4188
VELQON_ALLOWED_ORIGIN=https://ghostxrun.github.io,https://velqon.fun,https://www.velqon.fun
VELQON_DB_PATH=.velqon/data/velqon.sqlite
SOLANA_RPC_URL=https://solana-rpc.publicnode.com

# Public build settings, only needed when the frontend and backend use different hosts.
VITE_VELQON_API_ORIGIN=
# Optional public RPC URL. Prefer the backend proxy for credentialed RPC providers.
VITE_SOLANA_RPC_URL=
